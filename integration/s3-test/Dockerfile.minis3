FROM golang:1.27-alpine@sha256:fa4881266890ef051f0ce63afdfaccb69bbe8186084387f4fafd60d7ecbabc71 AS builder
ENV GOTOOLCHAIN=auto
WORKDIR /app
COPY go.mod ./
RUN go mod download
COPY internal ./internal
COPY integration/s3-test/main.go ./integration/s3-test/
RUN CGO_ENABLED=0 go build -o minis3 ./integration/s3-test

FROM alpine:3.24@sha256:ce9e1e6d23f04a0b7593445a062a9fc73ed52f8260b9396f77a958295ad18ee7
RUN apk add --no-cache wget
COPY --from=builder /app/minis3 /usr/local/bin/
EXPOSE 9000
CMD ["minis3", "-addr", "0.0.0.0:9000"]
