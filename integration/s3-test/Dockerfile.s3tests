FROM python:3.14-slim@sha256:0741d101873c12ab927e6f8653feb8862b9bd58771177acb1b885b95141f91b4

WORKDIR /s3-tests
COPY s3-tests/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY s3-tests/ .
COPY s3tests.conf /s3tests.conf
COPY sitecustomize.py /s3-tests/sitecustomize.py
COPY conftest.py /s3-tests/conftest.py

ENV S3TEST_CONF=/s3tests.conf

# Deselected: test_sse_kms_no_key expects PutObject with aws:kms and no key
# ID to fail, but AWS uses the default key in that case and succeeds, which
# is also minis3's behavior.
# Deselected: bad_expect_mismatch tests send an unknown Expect header value,
# which Go's net/http server rejects with 417 before minis3 sees the request.
# AWS ignores unknown Expect values.
ENTRYPOINT ["pytest", "-v", "--tb=short", "s3tests/functional/test_s3.py", "s3tests/functional/test_headers.py", "s3tests/functional/test_iam.py::test_put_user_policy", "s3tests/functional/test_iam.py::test_put_user_policy_invalid_user", "s3tests/functional/test_iam.py::test_put_user_policy_parameter_limit", "s3tests/functional/test_iam.py::test_put_user_policy_invalid_element", "s3tests/functional/test_iam.py::test_put_existing_user_policy", "s3tests/functional/test_iam.py::test_list_user_policy", "s3tests/functional/test_iam.py::test_list_user_policy_invalid_user", "s3tests/functional/test_iam.py::test_get_user_policy", "s3tests/functional/test_iam.py::test_get_user_policy_invalid_user", "s3tests/functional/test_iam.py::test_get_user_policy_invalid_policy_name", "s3tests/functional/test_iam.py::test_get_deleted_user_policy", "s3tests/functional/test_iam.py::test_get_user_policy_from_multiple_policies", "s3tests/functional/test_iam.py::test_delete_user_policy", "s3tests/functional/test_iam.py::test_delete_user_policy_invalid_user", "s3tests/functional/test_iam.py::test_delete_user_policy_invalid_policy_name", "s3tests/functional/test_iam.py::test_delete_user_policy_from_multiple_policies", "--deselect", "s3tests/functional/test_s3.py::test_sse_kms_no_key", "--deselect", "s3tests/functional/test_headers.py::test_object_create_bad_expect_mismatch", "--deselect", "s3tests/functional/test_headers.py::test_bucket_create_bad_expect_mismatch"]
